# Local development example only. Do not commit real secrets.
INBOXGUARDIAN_ENV=local
INBOXGUARDIAN_API_TOKEN=replace-with-local-demo-token
INBOXGUARDIAN_MAX_BODY_CHARS=50000
# Optional VirusTotal reputation enrichment is disabled unless explicitly enabled.
INBOXGUARDIAN_VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=replace-with-local-virustotal-key
